{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/wa-status", "dest": "/api/wa-status.js" },
    { "src": "/api/wa-logout", "dest": "/api/wa-logout.js" },
    { "src": "/api/schedule", "dest": "/api/schedule.js" },
    { "src": "/app.js", "dest": "/app.js" },
    { "src": "/", "dest": "/index.html" }
  ]
}
